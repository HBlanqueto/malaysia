+# MalaysiaDreams focus mode (adw-focus-mode.c): infinity_focus_v1 client code
+# for GTK's Wayland backend. Without it the module builds as a no-op.
+gtk_wayland_dep = dependency('gtk4-wayland', version: gtk_min_version, required: false)
+wayland_client_dep = dependency('wayland-client', required: false)
+wayland_scanner_dep = dependency('wayland-scanner', native: true, required: false)
+
+if gtk_wayland_dep.found() and wayland_client_dep.found() and wayland_scanner_dep.found()
+  wayland_scanner = find_program(wayland_scanner_dep.get_variable(pkgconfig: 'wayland_scanner'))
+  infinity_focus_xml = files('protocols/infinity-focus-v1.xml')
+
+  libadwaita_private_sources += [
+    custom_target('infinity-focus-v1-client-protocol.h',
+       input: infinity_focus_xml,
+      output: 'infinity-focus-v1-client-protocol.h',
+     command: [wayland_scanner, 'client-header', '@INPUT@', '@OUTPUT@'],
+    ),
+    custom_target('infinity-focus-v1-protocol.c',
+       input: infinity_focus_xml,
+      output: 'infinity-focus-v1-protocol.c',
+     command: [wayland_scanner, 'private-code', '@INPUT@', '@OUTPUT@'],
+    ),
+  ]
+  libadwaita_deps += [gtk_wayland_dep, wayland_client_dep]
+  config_h.set('HAVE_INFINITY_FOCUS', 1)
+endif
+
 libadwaita_sources = [
   libadwaita_generated_headers,
   libadwaita_public_sources,
diff --git a/src/protocols/infinity-focus-v1.xml b/src/protocols/infinity-focus-v1.xml
new file mode 100644
index 0000000..d779a73
--- /dev/null
+++ b/src/protocols/infinity-focus-v1.xml
@@ -0,0 +1,79 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  Copied verbatim (below this comment) from MalaysiaDreams' barrierkit:
+  https://github.com/HBlanqueto/barrierkit, file
+  crates/infinity-protocol/protocols/infinity-focus-v1.xml, revision c8965c3.
+  It is MIT-licensed (notice in <copyright>); keep both copies in step.
+-->
+<protocol name="infinity_focus_v1">
+  <copyright>
+    Copyright © 2026 MalaysiaDreams contributors
+
+    Permission is hereby granted, free of charge, to any person obtaining a
+    copy of this software and associated documentation files (the "Software"),
+    to deal in the Software without restriction, including without limitation
+    the rights to use, copy, modify, merge, publish, distribute, sublicense,
+    and/or sell copies of the Software, and to permit persons to whom the
+    Software is furnished to do so, subject to the following conditions:
+
+    The above copyright notice and this permission notice (including the next
+    paragraph) shall be included in all copies or substantial portions of the
+    Software.
+
+    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+
+  <interface name="infinity_focus_manager_v1" version="1">
+    <description summary="focus mode notices for applications">
+      MalaysiaDreams focus mode (ADR 0051): a maximized window gets a space of
+      its own and the xdg fullscreen state. In that space, the pointer at the
+      top edge brings the bar down; a client-decorated window is moved down
+      by the bar's height so its own titlebar stays visible under it.
+
+      This global tells a client-decorated application when that happens, so
+      it can hide its window controls while in focus mode and show them with
+      the bar, as macOS does. It carries no geometry and grants nothing, so
+      every client may bind it.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the manager">
+        Objects created through it keep working.
+      </description>
+    </request>
+
+    <request name="get_focus_surface">
+      <description summary="follow focus mode for a toplevel surface">
+        Creates an object that reports focus-mode notices for the toplevel
+        whose wl_surface is given.
+      </description>
+      <arg name="id" type="new_id" interface="infinity_focus_surface_v1"/>
+      <arg name="surface" type="object" interface="wl_surface"/>
+    </request>
+  </interface>
+
+  <interface name="infinity_focus_surface_v1" version="1">
+    <description summary="focus mode notices for one toplevel"/>
+
+    <request name="destroy" type="destructor">
+      <description summary="stop the notices"/>
+    </request>
+
+    <event name="bar">
+      <description summary="the bar came down or went up over the window">
+        Sent while the toplevel is in focus mode (it has the xdg fullscreen
+        state). revealed is 1 when the bar is down over the window, which has
+        been moved down by the bar's height, and 0 when the bar is up again.
+        A client shows its window controls only while revealed is 1. Leaving
+        focus mode sends 0 if the bar was down.
+      </description>
+      <arg name="revealed" type="uint"/>
+    </event>
+  </interface>
+</protocol>
