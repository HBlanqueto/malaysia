# Dedicated systemd user unit for the Vulkan wallpaper client.
# One instance covers every output; it registers layer surfaces through
# layer-shell and restarts independently of the other shell components.
#
# Installed by the flake with the `@out@` placeholder replaced by the store
# path of the package.
[Unit]
Description=Malaysia Vulkan wallpaper client
PartOf=malaysia-session.target
After=malaysia-session.target
StartLimitBurst=10
StartLimitIntervalSec=30

[Service]
Type=simple
# The binary comes from MALAYSIA_BIN_DIR, which the compositor imports, so it always
# matches the running compositor; without it, from this package.
ExecStart=/bin/sh -c 'exec "$${MALAYSIA_BIN_DIR:-@out@/bin}/malaysia-wallpaper"'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=malaysia-session.target
