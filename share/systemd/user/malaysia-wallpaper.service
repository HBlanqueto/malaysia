# Dedicated systemd user unit for the Vulkan wallpaper client.
# One instance covers every output; it registers layer surfaces through
# layer-shell and restarts independently of the other shell components.
#
# Installed by the flake with the `@out@` placeholder replaced by the store
# path of the package.
[Unit]
Description=MalaysiaDreams Vulkan wallpaper client
PartOf=malaysia-session.target
After=malaysia-session.target

[Service]
Type=simple
ExecStart=@out@/bin/malaysia-wallpaper
Restart=on-failure
RestartSec=2
StartLimitBurst=10
StartLimitIntervalSec=30

[Install]
WantedBy=malaysia-session.target
