# One unit per shell component (ADR 0023): `%i` is the component name
# (wallpaper, menubar, dock, ...). A component must be able to crash and
# restart without taking any other component (or the compositor) down.
#
# Installed by the flake with the `@out@` placeholder replaced by the store
# path of the package.
[Unit]
Description=MalaysiaDreams shell component (%i)
PartOf=malaysia-session.target
After=malaysia-session.target

[Service]
Type=simple
ExecStart=@out@/bin/malaysia-shell %i
Restart=on-failure
RestartSec=2
StartLimitBurst=10
StartLimitIntervalSec=30

[Install]
WantedBy=malaysia-session.target
