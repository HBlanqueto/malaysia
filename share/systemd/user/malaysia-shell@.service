# One unit per shell component (ADR 0023): `%i` is the component name
# (menubar, dock, ...); the wallpaper has its own unit. A component must be able to crash and
# restart without taking any other component (or the compositor) down.
#
# Installed by the flake with the `@out@` placeholder replaced by the store
# path of the package.
[Unit]
Description=Malaysia shell component (%i)
PartOf=malaysia-session.target
After=malaysia-session.target
StartLimitBurst=10
StartLimitIntervalSec=30

[Service]
Type=simple
# The binary comes from MALAYSIA_BIN_DIR, which the compositor imports, so it always
# matches the running compositor; without it, from this package.
ExecStart=/bin/sh -c 'exec "$${MALAYSIA_BIN_DIR:-@out@/bin}/malaysia-shell" "$$1"' sh %i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=malaysia-session.target
